<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="40.0" styleClass="content-pane" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.thomazcollet.ui.controller.TimerController">
    
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblStatus" text="HORA DE FOCAR" styleClass="status-label" />

    <StackPane>
        <Circle radius="150.0" stroke="#313244" strokeWidth="15.0" fill="TRANSPARENT" />
        
        <Arc fx:id="arcProgress" radiusX="150.0" radiusY="150.0" startAngle="90.0" length="360.0" 
             stroke="#89b4fa" strokeWidth="15.0" fill="TRANSPARENT" strokeLineCap="ROUND" />

        <Label fx:id="lblTime" text="25:00" styleClass="timer-text" />
    </StackPane>

    <HBox alignment="CENTER" spacing="20.0">
        <Button fx:id="btnStart" text="START" styleClass="action-button, start-button" />
        <Button fx:id="btnPause" text="PAUSE" styleClass="action-button, pause-button" />
        <Button fx:id="btnStop" text="STOP" styleClass="action-button, stop-button" />
    </HBox>

</VBox>