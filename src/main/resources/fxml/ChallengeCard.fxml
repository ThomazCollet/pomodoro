<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>

<HBox alignment="TOP_LEFT" spacing="15.0" styleClass="challenge-card" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thomazcollet.ui.controller.ChallengeCardController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    
    <VBox spacing="12.0" HBox.hgrow="ALWAYS">
        <children>
            <HBox alignment="CENTER_LEFT">
                <children>
                    <Label fx:id="lblTitle" styleClass="card-title" text="Título do Desafio" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblDailyGoal" styleClass="small-text" style="-fx-font-weight: bold; -fx-text-fill: #00adb5;" text="0/0 min" />
                </children>
            </HBox>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <ProgressBar fx:id="progressChallenge" maxWidth="Infinity" progress="0.5" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblProgressDays" minWidth="65.0" styleClass="small-text" text="0/30 dias" />
                </children>
            </HBox>
            
            <HBox fx:id="livesContainer" alignment="CENTER_LEFT" spacing="6.0" style="-fx-padding: 5 0 0 0;" />
        </children>
    </VBox>

    <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDelete" styleClass="delete-btn-small" text="✕" />
</HBox>