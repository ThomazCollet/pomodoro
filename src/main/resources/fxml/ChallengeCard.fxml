<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="challenge-card" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thomazcollet.ui.controller.ChallengeCardController">
    <padding>
        <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
    </padding>
    
    <VBox spacing="8.0" HBox.hgrow="ALWAYS">
        <children>
            <Label fx:id="lblTitle" styleClass="card-title" text="Título do Desafio" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <children>
                    <ProgressBar fx:id="progressChallenge" maxWidth="Infinity" progress="0.5" HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblProgressDays" styleClass="small-text" text="5/10 dias" />
                </children>
            </HBox>
        </children>
    </VBox>

    <VBox alignment="CENTER" spacing="5.0">
        <children>
            <Label styleClass="mini-label" text="VIDAS" />
            <HBox fx:id="livesContainer" alignment="CENTER" spacing="4.0">
                </HBox>
        </children>
    </VBox>

    <Button fx:id="btnDelete" mnemonicParsing="false" onAction="#onDelete" styleClass="delete-btn-small" text="✕" />
</HBox>