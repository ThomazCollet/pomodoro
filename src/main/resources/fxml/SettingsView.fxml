<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<ScrollPane fitToWidth="true" styleClass="content-pane" stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.thomazcollet.ui.controller.SettingsController">

    <VBox spacing="16" styleClass="settings-root">
        <padding>
            <Insets bottom="40.0" left="36.0" right="36.0" top="32.0"/>
        </padding>

        <!-- ═══════════════════════════ HEADER ═══════════════════════════ -->
        <VBox spacing="4.0" styleClass="settings-page-header">
            <padding><Insets bottom="28.0"/></padding>
            <Label text="CONFIGURAÇÕES" styleClass="logo-text"/>
            <Label text="Personalize sua experiência de foco" styleClass="subtitle-label"/>
        </VBox>

        <!-- ═══════════════════════════ SEÇÃO: PERFIL ═══════════════════════════ -->
        <VBox styleClass="settings-section">
            <Label text="👤  Perfil" styleClass="settings-section-title"/>

            <HBox spacing="24.0" alignment="CENTER_LEFT">

                <!-- Avatar -->
                <VBox spacing="10.0" alignment="CENTER" minWidth="100.0">
                    <StackPane fx:id="settingsAvatarContainer" styleClass="settings-avatar-container">
                        <Circle fx:id="settingsAvatarCircle" radius="38.0"/>
                        <Label fx:id="settingsAvatarInitial" text="?" styleClass="settings-avatar-text"
                               mouseTransparent="true"/>
                    </StackPane>
                    <Button fx:id="btnChangeAvatar" text="Alterar foto"
                            styleClass="settings-link-button"
                            onAction="#handleChangeAvatar"/>
                </VBox>

                <!-- Campos -->
                <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                    <VBox spacing="6.0">
                        <Label text="Nome de exibição" styleClass="settings-field-label"/>
                        <TextField fx:id="txtUsername" promptText="Ex: Thomaz"
                                   styleClass="dark-input" maxWidth="360.0"/>
                        <Label fx:id="lblUsernameError" styleClass="settings-field-error"
                               visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" styleClass="settings-save-row">
                <Button fx:id="btnSaveProfile" text="Salvar Perfil"
                        styleClass="settings-save-button"
                        onAction="#handleSaveProfile"/>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════ SEÇÃO: METAS ═══════════════════════════ -->
        <VBox styleClass="settings-section">
            <Label text="🎯  Metas de Foco" styleClass="settings-section-title"/>
            <Label text="As metas determinam quando a estrela ⭐ aparece no gráfico de barras."
                   styleClass="settings-field-hint" wrapText="true"/>

            <HBox spacing="20.0" style="-fx-padding: 16 0 0 0;">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Meta Diária" styleClass="settings-field-label"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Spinner fx:id="spnDailyGoalHours" editable="true"
                                 prefWidth="80.0" styleClass="spinner"/>
                        <Label text="h" styleClass="settings-unit-label"/>
                        <Spinner fx:id="spnDailyGoalMinutes" editable="true"
                                 prefWidth="80.0" styleClass="spinner"/>
                        <Label text="min" styleClass="settings-unit-label"/>
                    </HBox>
                </VBox>

                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Meta Semanal" styleClass="settings-field-label"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Spinner fx:id="spnWeeklyGoalHours" editable="true"
                                 prefWidth="80.0" styleClass="spinner"/>
                        <Label text="h" styleClass="settings-unit-label"/>
                    </HBox>
                </VBox>

                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Meta Mensal" styleClass="settings-field-label"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                        <Spinner fx:id="spnMonthlyGoalHours" editable="true"
                                 prefWidth="80.0" styleClass="spinner"/>
                        <Label text="h" styleClass="settings-unit-label"/>
                    </HBox>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" styleClass="settings-save-row">
                <Button fx:id="btnSaveGoals" text="Salvar Metas"
                        styleClass="settings-save-button"
                        onAction="#handleSaveGoals"/>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════ SEÇÃO: FOCO ═══════════════════════════ -->
        <VBox styleClass="settings-section">
            <Label text="⏱  Configurações de Foco" styleClass="settings-section-title"/>

            <HBox spacing="16.0" alignment="CENTER_LEFT" style="-fx-padding: 8 0 16 0;">
                <RadioButton fx:id="rdoFocusDefault" text="Padrão  (25 / 5 / 15 min)"
                             styleClass="settings-radio"
                             onAction="#handleFocusModeChanged"/>
                <RadioButton fx:id="rdoFocusCustom" text="Personalizado"
                             styleClass="settings-radio"
                             onAction="#handleFocusModeChanged"/>
            </HBox>

            <HBox fx:id="boxFocusCustomFields" spacing="20.0" disable="true">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Foco (min)" styleClass="settings-field-label"/>
                    <Spinner fx:id="spnWorkDuration" editable="true"
                             prefWidth="110.0" styleClass="spinner"/>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Pausa Curta (min)" styleClass="settings-field-label"/>
                    <Spinner fx:id="spnShortBreak" editable="true"
                             prefWidth="110.0" styleClass="spinner"/>
                </VBox>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Pausa Longa (min)" styleClass="settings-field-label"/>
                    <Spinner fx:id="spnLongBreak" editable="true"
                             prefWidth="110.0" styleClass="spinner"/>
                </VBox>
            </HBox>

            <HBox alignment="CENTER_RIGHT" styleClass="settings-save-row">
                <Button fx:id="btnSaveFocus" text="Salvar Configurações de Foco"
                        styleClass="settings-save-button"
                        onAction="#handleSaveFocus"/>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════ SEÇÃO: ÁUDIO ═══════════════════════════ -->
        <VBox styleClass="settings-section">
            <Label text="🔊  Áudio" styleClass="settings-section-title"/>

            <VBox spacing="10.0" style="-fx-padding: 8 0 0 0;">
                <Label text="Volume dos sons do timer" styleClass="settings-field-label"/>
                <HBox spacing="16.0" alignment="CENTER_LEFT">
                    <Slider fx:id="sliderVolume" min="0" max="100" blockIncrement="5"
                            showTickMarks="true" showTickLabels="true" majorTickUnit="25"
                            styleClass="settings-slider" HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblVolumeValue" text="100%" styleClass="settings-unit-label"
                           minWidth="40.0"/>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT" styleClass="settings-save-row">
                <Button fx:id="btnSaveAudio" text="Salvar Áudio"
                        styleClass="settings-save-button"
                        onAction="#handleSaveAudio"/>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════ SEÇÃO: NOTIFICAÇÕES ═══════════════════════════ -->
        <VBox styleClass="settings-section">
            <Label text="🔔  Notificações" styleClass="settings-section-title"/>

            <VBox spacing="12.0" style="-fx-padding: 8 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="14.0">
                    <ToggleButton fx:id="tglNotifications" styleClass="settings-toggle"
                                  onAction="#handleNotificationsToggle"/>
                    <VBox spacing="2.0">
                        <Label text="Toasts e sons de notificação"
                               styleClass="settings-field-label"/>
                        <Label text="Conquistas, ciclos concluídos, metas atingidas e desafios."
                               styleClass="settings-field-hint"/>
                    </VBox>
                </HBox>
            </VBox>

            <HBox alignment="CENTER_RIGHT" styleClass="settings-save-row">
                <Button fx:id="btnSaveNotifications" text="Salvar Notificações"
                        styleClass="settings-save-button"
                        onAction="#handleSaveNotifications"/>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════ SEÇÃO: IDIOMA ═══════════════════════════ -->
        <VBox styleClass="settings-section">
            <Label text="🌐  Idioma" styleClass="settings-section-title"/>
            <Label text="A tradução completa da interface será disponibilizada em versões futuras. A preferência salva aqui já é persistida no seu perfil."
                   styleClass="settings-field-hint" wrapText="true"/>

            <VBox spacing="6.0" style="-fx-padding: 12 0 0 0;">
                <Label text="Idioma preferido" styleClass="settings-field-label"/>
                <ComboBox fx:id="cmbLanguage" prefWidth="240.0" styleClass="settings-combo"/>
            </VBox>

            <HBox alignment="CENTER_RIGHT" styleClass="settings-save-row">
                <Button fx:id="btnSaveLanguage" text="Salvar Idioma"
                        styleClass="settings-save-button"
                        onAction="#handleSaveLanguage"/>
            </HBox>
        </VBox>

        <!-- ═══════════════════════════ SEÇÃO: ZONA DE RISCO ═══════════════════════════ -->
        <VBox styleClass="settings-section, settings-section-danger">
            <Label text="⚠️  Zona de Risco" styleClass="settings-section-title-danger"/>
            <Label text="Ações irreversíveis. Use com cautela."
                   styleClass="settings-field-hint" wrapText="true"/>

            <HBox spacing="12.0" style="-fx-padding: 16 0 0 0;">
                <Button fx:id="btnClearHistory" text="Limpar Histórico de Foco"
                        styleClass="settings-danger-button"
                        onAction="#handleClearHistory"/>
                <Button fx:id="btnResetProgress" text="Resetar Todo o Progresso"
                        styleClass="settings-danger-button-strong"
                        onAction="#handleResetProgress"/>
            </HBox>
        </VBox>

    </VBox>
</ScrollPane>
