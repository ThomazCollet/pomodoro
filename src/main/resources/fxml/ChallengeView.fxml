<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="rootStackPane" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.thomazcollet.ui.controller.ChallengeController">

    <VBox spacing="20.0" styleClass="main-container">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- HEADER                                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <VBox>
                <Label styleClass="title-label" text="DESAFIOS" />
                <Label styleClass="subtitle-label" text="Mantenha sua constância e suba de nível" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNewChallenge" minWidth="160.0" mnemonicParsing="false"
                    onAction="#handleNewChallenge" styleClass="action-button" text="+ NOVO DESAFIO">
                <padding><Insets left="15.0" right="15.0" /></padding>
            </Button>
        </HBox>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SCROLL PRINCIPAL                                         -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="dark-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="0.0">
                    <padding>
                        <Insets bottom="30.0" left="10.0" right="10.0" top="10.0" />
                    </padding>

                    <!-- ─────────────────────────────────────────── -->
                    <!-- EM ANDAMENTO                                 -->
                    <!-- ─────────────────────────────────────────── -->
                    <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                        <padding><Insets top="30.0" /></padding>
                        <Label styleClass="section-title" text="EM ANDAMENTO" />
                        <VBox fx:id="challengesContainer" alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS" />
                    </VBox>

                    <!-- ─────────────────────────────────────────── -->
                    <!-- HISTÓRICO — seção colapsável                 -->
                    <!-- ─────────────────────────────────────────── -->
                    <VBox fx:id="historySection" spacing="0.0"
                          style="-fx-padding: 36 0 0 0;">

                        <!--
                            HEADER DA SEÇÃO — bloco clicável com fundo sutil.
                            onMouseClicked dispara handleToggleHistory() no controller.
                        -->
                        <VBox styleClass="history-header-block"
                              onMouseClicked="#handleToggleHistory">

                            <!-- Linha 1: título + seta -->
                            <HBox alignment="CENTER_LEFT" spacing="10.0"
                                  styleClass="history-header-title-row">

                                <Label fx:id="lblHistoryToggleIcon"
                                       text="▶"
                                       styleClass="history-toggle-icon" />

                                <Label text="CONCLUÍDOS"
                                       styleClass="section-title"
                                       style="-fx-font-size: 11px;" />

                                <!-- Separador que ocupa o restante da largura -->
                                <Separator HBox.hgrow="ALWAYS"
                                           styleClass="history-separator"
                                           style="-fx-padding: 0 0 0 6;" />
                            </HBox>

                            <!-- Linha 2: estatísticas em fonte menor, abaixo do título -->
                            <HBox alignment="CENTER_LEFT" spacing="0.0"
                                  style="-fx-padding: 4 0 0 24;">
                                <Label fx:id="lblHistorySummary"
                                       styleClass="history-summary-label"
                                       text=""
                                       wrapText="true"
                                       maxWidth="Infinity"
                                       HBox.hgrow="ALWAYS">
                                    <tooltip>
                                        <Tooltip text="Clique para expandir ou recolher o histórico" />
                                    </tooltip>
                                </Label>
                            </HBox>

                        </VBox>

                        <!-- Cards colapsáveis — ocultos por padrão -->
                        <VBox fx:id="historyCardsContainer" spacing="12.0"
                              visible="false" managed="false"
                              style="-fx-padding: 12 0 10 0;" />

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </VBox>

</StackPane>
