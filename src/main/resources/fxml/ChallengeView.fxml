<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<StackPane fx:id="rootStackPane" stylesheets="@../css/style.css"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.thomazcollet.ui.controller.ChallengeController">

    <VBox spacing="20.0" styleClass="main-container">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- HEADER                                                   -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <VBox>
                <Label styleClass="title-label" text="DESAFIOS" />
                <Label styleClass="subtitle-label" text="Mantenha sua constância e suba de nível" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNewChallenge" minWidth="160.0" mnemonicParsing="false"
                    onAction="#handleNewChallenge" styleClass="action-button" text="+ NOVO DESAFIO">
                <padding><Insets left="15.0" right="15.0" /></padding>
            </Button>
        </HBox>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- SCROLL PRINCIPAL                                         -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <ScrollPane fitToHeight="true" fitToWidth="true" styleClass="dark-scroll" VBox.vgrow="ALWAYS">
            <content>
                <VBox spacing="0.0">
                    <padding>
                        <Insets bottom="30.0" left="10.0" right="20.0" top="10.0" />
                    </padding>

                    <!-- ─────────────────────────────────────────── -->
                    <!-- EM ANDAMENTO                                 -->
                    <!-- ─────────────────────────────────────────── -->
                    <VBox spacing="15.0" VBox.vgrow="ALWAYS">
                        <padding><Insets top="30.0" /></padding>

                        <Label styleClass="section-title" text="EM ANDAMENTO" />

                        <VBox fx:id="challengesContainer" alignment="CENTER" spacing="15.0" VBox.vgrow="ALWAYS">
                            <!-- populado pelo controller -->
                        </VBox>
                    </VBox>

                    <!-- ─────────────────────────────────────────── -->
                    <!-- HISTÓRICO (seção colapsável)                 -->
                    <!-- ─────────────────────────────────────────── -->
                    <VBox fx:id="historySection" spacing="0.0" style="-fx-padding: 30 0 0 0;">

                        <Separator opacity="0.12" />

                        <!-- Header clicável da seção de histórico -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0"
                              styleClass="history-section-header"
                              onMouseClicked="#handleToggleHistory"
                              style="-fx-cursor: hand; -fx-padding: 14 4 10 4;">

                            <Label fx:id="lblHistoryToggleIcon" text="▶"
                                   styleClass="history-toggle-icon" />

                            <Label text="CONCLUÍDOS" styleClass="section-title"
                                   style="-fx-font-size: 11px;" />

                            <Region HBox.hgrow="ALWAYS" />

                            <!-- Barra de resumo dinâmica -->
                            <Label fx:id="lblHistorySummary"
                                   styleClass="history-summary-label"
                                   text="Carregando..."
                                   wrapText="false"
                                   maxWidth="600.0"
                                   style="-fx-font-size: 12px;" />
                        </HBox>

                        <!-- Cards colapsáveis — ocultos por padrão -->
                        <VBox fx:id="historyCardsContainer" spacing="12.0"
                              visible="false" managed="false"
                              style="-fx-padding: 4 0 10 0;">
                            <!-- populado pelo controller -->
                        </VBox>

                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </VBox>

</StackPane>
