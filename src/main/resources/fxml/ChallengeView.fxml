<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="main-container" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thomazcollet.ui.controller.ChallengeController">
    <padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    
    <HBox alignment="CENTER_LEFT" spacing="15.0">
        <children>
            <VBox>
                <children>
                    <Label styleClass="title-label" text="DESAFIOS" />
                    <Label styleClass="subtitle-label" text="Mantenha sua constância e suba de nível" />
                </children>
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button fx:id="btnNewChallenge" mnemonicParsing="false" onAction="#handleNewChallenge" styleClass="action-button" text="+ NOVO DESAFIO" />
        </children>
    </HBox>

    <ScrollPane fitToWidth="true" styleClass="dark-scroll" VBox.vgrow="ALWAYS">
        <content>
            <VBox fx:id="challengesContainer" spacing="15.0">
                <padding>
                    <Insets bottom="10.0" left="5.0" right="15.0" top="10.0" />
                </padding>
                </VBox>
        </content>
    </ScrollPane>
</VBox>