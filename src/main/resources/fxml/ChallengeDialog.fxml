<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="20.0" styleClass="dialog-container" stylesheets="@../css/style.css" 
      prefWidth="420.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.thomazcollet.ui.controller.ChallengeDialogController">
    
    <padding>
        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
    </padding>

    <VBox spacing="5.0">
        <Label styleClass="title-label" text="NOVO DESAFIO" style="-fx-font-size: 18px;" />
        <Label styleClass="subtitle-label" text="Defina sua próxima meta de foco" />
    </VBox>

    <VBox spacing="15.0">
        <VBox spacing="5.0">
            <Label styleClass="small-text" text="Qual o nome do desafio?" />
            <TextField fx:id="txtTitle" promptText="Ex: Estudar idiomas ou para a faculdade" styleClass="dark-input" />
        </VBox>

        <HBox spacing="20.0">
            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label styleClass="small-text" text="Duração (Dias)" />
                <Spinner fx:id="spinnerDuration" editable="true" maxWidth="Infinity" />
            </VBox>

            <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                <Label styleClass="small-text" text="Vidas (Resiliência)" />
                <Spinner fx:id="spinnerLives" editable="true" maxWidth="Infinity" />
            </VBox>
        </HBox>
        <Label fx:id="lblLimitWarning" text="Limite de resiliência: 25% da duração total." 
           style="-fx-text-fill: #f38ba8; -fx-font-size: 11px;" visible="false" managed="false" />
    </VBox>

    <HBox alignment="CENTER_RIGHT" spacing="12.0">
        <padding>
            <Insets top="10.0" />
        </padding>
        <Button onAction="#handleCancel" styleClass="delete-btn-small" text="Cancelar" />
        <Button fx:id="btnSave" onAction="#handleSave" styleClass="action-button" text="CRIAR DESAFIO" minWidth="160.0">
            <padding>
                <Insets left="20.0" right="20.0" />
            </padding>
        </Button>
    </HBox>
</VBox>