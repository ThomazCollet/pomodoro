<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox fx:id="rootPane" alignment="CENTER" styleClass="mini-content-pane" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.thomazcollet.ui.controller.MiniTimerController">
    
    <padding>
        <Insets top="10.0" right="15.0" bottom="12.0" left="15.0" />
    </padding>

    <HBox fx:id="topBar" styleClass="mini-top-bar" alignment="CENTER_RIGHT" spacing="10.0">
        <Button fx:id="btnBackToApp" text="🗕" styleClass="mini-top-button" onAction="#handleBackToApp">
            <tooltip><Tooltip text="Minimizar e voltar para o aplicativo completo" /></tooltip>
        </Button>
        <Button fx:id="btnClose" text="✕" styleClass="mini-top-button, mini-close" onAction="#handleCloseApp">
            <tooltip><Tooltip text="Fechar aplicação" /></tooltip>
        </Button>
    </HBox>

    <VBox alignment="CENTER" spacing="8.0" VBox.vgrow="ALWAYS" styleClass="mini-display-container">
        <Label fx:id="lblTime" text="25:00" styleClass="mini-timer-text" alignment="CENTER" />
        <HBox fx:id="hboxPips" alignment="CENTER" spacing="8.0" styleClass="mini-pip-container" />
    </VBox>

    <HBox fx:id="controlDock" alignment="CENTER" spacing="16.0" styleClass="mini-control-dock">
        <padding>
            <Insets left="15.0" right="15.0" top="6.0" bottom="6.0"/>
        </padding>

        <Button fx:id="btnMute" text="🔊" styleClass="mini-dock-util" onAction="#handleToggleMute">
            <tooltip><Tooltip text="Mutar/Desmutar" /></tooltip>
        </Button>
        
        <Button fx:id="btnPlayPause" text="▶" styleClass="mini-dock-main" onAction="#handlePlayPauseToggle">
            <tooltip><Tooltip text="Iniciar / Pausar" /></tooltip>
        </Button>
    </HBox>
    
</VBox>