<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<?import javafx.geometry.Insets?>

<ScrollPane fitToWidth="true" styleClass="content-pane" stylesheets="@../css/style.css" 
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.thomazcollet.ui.controller.StatsController">
    
    <VBox spacing="25.0" styleClass="stats-container">
        <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
        </padding>

        <HBox alignment="CENTER_LEFT">
            <Label styleClass="logo-text" text="ESTATÍSTICAS DE FOCO" />
        </HBox>

        <HBox spacing="20.0">
            <VBox styleClass="stats-card, card-accent-peach" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-card-title" text="STREAK ATUAL" />
                <Label fx:id="lblCurrentStreak" styleClass="stat-card-value" text="🔥 12 dias" />
                <Label fx:id="lblMaxStreak" styleClass="stat-card-record" text="Recorde: 24 dias" />
            </VBox>

            <VBox styleClass="stats-card, card-accent-blue" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-card-title" text="FOCO HOJE" />
                <Label fx:id="lblFocusToday" styleClass="stat-card-value" text="04h 20m" />
                <Label fx:id="lblRecordToday" styleClass="stat-card-record" text="Recorde: 08h 15m" />
            </VBox>

            <VBox styleClass="stats-card, card-accent-mauve" HBox.hgrow="ALWAYS">
                <Label styleClass="stat-card-title" text="ESTA SEMANA" />
                <Label fx:id="lblFocusWeek" styleClass="stat-card-value" text="28h 45m" />
                <Label fx:id="lblRecordWeek" styleClass="stat-card-record" text="Melhor Semana: --" />
            </VBox>
        </HBox>

        <VBox spacing="10.0" styleClass="chart-container">
            <Label styleClass="section-title" text="ATIVIDADE ANUAL (CONTRIBUIÇÕES DE FOCO)" />
            
            <ScrollPane fx:id="heatmapScrollPane" 
                        fitToHeight="true" 
                        minHeight="150.0" 
                        styleClass="heatmap-scroll" 
                        vbarPolicy="NEVER" 
                        pannable="true">
                <content>
                    <GridPane fx:id="heatmapGrid" hgap="3.0" vgap="3.0" styleClass="heatmap-grid">
                        <padding>
                            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                        </padding>
                    </GridPane>
                </content>
            </ScrollPane>
        </VBox>

        <VBox spacing="15.0" styleClass="chart-container">
            <StackPane>
                <Label styleClass="section-title" text="DISTRIBUIÇÃO DE TEMPO" StackPane.alignment="CENTER_LEFT" />
                
                <HBox styleClass="toggle-group-container" maxWidth="-Infinity" StackPane.alignment="CENTER_RIGHT">
                    <ToggleButton fx:id="btnLast7Days" selected="true" styleClass="toggle-left" text="7 dias" />
                    <ToggleButton fx:id="btnLast30Days" styleClass="toggle-center" text="8 semanas" />
                    <ToggleButton fx:id="btnLastYear" styleClass="toggle-right" text="12 meses" />
                </HBox>
            </StackPane>
            
            <StackPane fx:id="chartWrapper" VBox.vgrow="ALWAYS">
                <BarChart fx:id="barChartFocus" animated="false" legendVisible="false" prefHeight="300.0" pickOnBounds="false"
                          maxWidth="Infinity" maxHeight="Infinity">
                    <xAxis>
                        <CategoryAxis side="BOTTOM" fx:id="xAxis" />
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Horas" side="LEFT" />
                    </yAxis>
                </BarChart>
            </StackPane>
        </VBox>
        
        <HBox spacing="15.0" VBox.vgrow="NEVER">
            <VBox spacing="10.0" styleClass="chart-container" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="🏆 DIAS RECORDISTAS" />
                <ListView fx:id="listDailyPodium" prefHeight="160.0" prefWidth="-1" maxWidth="Infinity" styleClass="podium-list-view" VBox.vgrow="ALWAYS" />
            </VBox>
            
            <VBox spacing="10.0" styleClass="chart-container" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="📅 MESES RECORDISTAS" />
                <ListView fx:id="listMonthlyPodium" prefHeight="160.0" prefWidth="-1" maxWidth="Infinity" styleClass="podium-list-view" VBox.vgrow="ALWAYS" />
            </VBox>

            <VBox spacing="10.0" styleClass="chart-container" HBox.hgrow="ALWAYS">
                <Label styleClass="section-title" text="🔥 MAIORES STREAKS" />
                <ListView fx:id="listStreakPodium" prefHeight="160.0" prefWidth="-1" maxWidth="Infinity" styleClass="podium-list-view" VBox.vgrow="ALWAYS" />
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>