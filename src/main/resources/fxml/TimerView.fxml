<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Tooltip?>

<VBox alignment="CENTER" spacing="40.0" styleClass="content-pane" 
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.thomazcollet.ui.controller.TimerController">
    
    <padding>
        <Insets bottom="30.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="lblStatus" text="HORA DE FOCAR" styleClass="status-label" />

    <StackPane fx:id="timerStackPane">
        <Circle radius="160.0" stroke="#313244" strokeWidth="8.0" fill="TRANSPARENT" />

        <Arc fx:id="arcProgress" radiusX="160.0" radiusY="160.0" startAngle="90.0" length="360.0"
             stroke="#89b4fa" strokeWidth="12.0" fill="TRANSPARENT" strokeLineCap="BUTT" />

        <Label fx:id="lblTime" text="25:00" styleClass="timer-text" />
    </StackPane>

    <HBox fx:id="hboxPips" alignment="CENTER" spacing="12.0" styleClass="pip-container" />

    <HBox alignment="CENTER" spacing="20.0" styleClass="timer-control-dock">
        <padding>
            <Insets left="25.0" right="25.0" top="12.0" bottom="12.0"/>
        </padding>

        <Button fx:id="btnMute" text="🔊" styleClass="dock-util-button, dock-mute" onAction="#handleToggleMute">
            <tooltip><Tooltip text="Mutar/Desmutar sons" /></tooltip>
        </Button>
        
        <Button fx:id="btnReset" text="🔄" styleClass="dock-media-button, dock-reset">
            <tooltip><Tooltip text="Reiniciar cronômetro" /></tooltip>
        </Button>
        
        <Button fx:id="btnPlayPause" text="▶" styleClass="dock-main-button">
            <tooltip><Tooltip text="Iniciar / Pausar" /></tooltip>
        </Button>
        
        <Button fx:id="btnSkip" text="⏭" styleClass="dock-media-button, dock-skip">
            <tooltip><Tooltip text="Pular sessão atual" /></tooltip>
        </Button>
        
        <Button fx:id="btnFloat" text="🗗" styleClass="dock-util-button, dock-float" onAction="#handleToggleFloatingWindow">
            <tooltip><Tooltip text="Abrir em modo mini/flutuante" /></tooltip>
        </Button>
    </HBox>
    
</VBox>