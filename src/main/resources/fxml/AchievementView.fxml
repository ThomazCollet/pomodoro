<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.FlowPane?>

<VBox prefHeight="650.0" prefWidth="900.0" 
      stylesheets="@../styles/achievements.css" 
      styleClass="main-achievements-container" 
      fx:controller="com.thomazcollet.ui.controller.AchievementViewController"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    
    <VBox spacing="4.0" styleClass="view-header">
        <padding>
            <Insets top="20.0" right="24.0" bottom="10.0" left="24.0"/>
        </padding>
        <Label text="CENTRAL DE PROGRESSO" styleClass="view-main-title"/>
        <Label text="Acompanhe suas metas, complete desafios e conquiste seu Rank" styleClass="view-subtitle"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS" styleClass="custom-tab-pane">
        
        <Tab text="Central de Conquistas">
            <VBox spacing="16.0">
                <padding>
                    <Insets top="16.0" right="24.0" bottom="16.0" left="24.0"/>
                </padding>
                
                <HBox spacing="20.0" alignment="CENTER" styleClass="medal-summary-header">
                    <HBox fx:id="btnBronzeSummary" styleClass="medal-summary-card, bronze-summary" alignment="CENTER" spacing="10.0">
                        <Label text="🥉" styleClass="summary-medal-icon"/>
                        <VBox alignment="CENTER_LEFT">
                            <Label text="BRONZE" styleClass="summary-medal-tier"/>
                            <Label fx:id="lblBronzeCount" text="0 / 0" styleClass="summary-medal-count"/>
                        </VBox>
                    </HBox>
                    
                    <HBox fx:id="btnSilverSummary" styleClass="medal-summary-card, silver-summary" alignment="CENTER" spacing="10.0">
                        <Label text="🥈" styleClass="summary-medal-icon"/>
                        <VBox alignment="CENTER_LEFT">
                            <Label text="PRATA" styleClass="summary-medal-tier"/>
                            <Label fx:id="lblSilverCount" text="0 / 0" styleClass="summary-medal-count"/>
                        </VBox>
                    </HBox>
                    
                    <HBox fx:id="btnGoldSummary" styleClass="medal-summary-card, gold-summary" alignment="CENTER" spacing="10.0">
                        <Label text="🥇" styleClass="summary-medal-icon"/>
                        <VBox alignment="CENTER_LEFT">
                            <Label text="OURO" styleClass="summary-medal-tier"/>
                            <Label fx:id="lblGoldCount" text="0 / 0" styleClass="summary-medal-count"/>
                        </VBox>
                    </HBox>
                </HBox>

                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS" styleClass="achievements-scroll">
                    <VBox fx:id="categoryContainer" spacing="28.0" styleClass="scroll-content-wrapper"/>
                </ScrollPane>
            </VBox>
        </Tab>
        
        <Tab text="Troféus de Platina">
            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="achievements-scroll">
                <VBox spacing="16.0" styleClass="scroll-content-wrapper">
                    <padding>
                        <Insets top="20.0" right="24.0" bottom="24.0" left="24.0"/>
                    </padding>
                    <Label text="💎 Relíquias de Platina" styleClass="category-section-title"/>
                    <Label text="Conquistas lendárias desbloqueadas automaticamente ao gabaritar as trilhas de Ouro." styleClass="platinum-hint-text"/>
                    
                    <FlowPane fx:id="platinumGridPane" hgap="16.0" vgap="16.0" styleClass="category-flow-pane"/>
                </VBox>
            </ScrollPane>
        </Tab>
        
    </TabPane>
</VBox>